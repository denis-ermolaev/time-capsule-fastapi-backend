# База данных ----
DB_NAME=api
DB_USER=api
DB_PASSWORD=your_secure_password_here
DB_HOST=db
DB_PORT=5432

# Авторизация ----
# Сгенерировать: openssl rand -hex 32
SECRET_KEY=your-secret-key-at-least-32-characters-long

# FastAPI settings ----
# Для code-server, который перенаправляя порт, добавляет к нему /proxy/8000
# чтобы приложение работало нужно добавить это сюда
# ROOT_PATH=/proxy/8000

# Прокси для сборки Docker-образа ----
# HTTP_PROXY=http://user:password@ip:port
# HTTPS_PROXY=http://user:password@ip:port
# NO_PROXY=localhost,127.0.0.1,.local
